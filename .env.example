# Copy to .env (gitignored). Nothing in this file is ever committed with real values.

# Better Auth: production values go in with `wrangler secret put` (see README)
BETTER_AUTH_SECRET=your_super_secret_better_auth_key_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3000
# AUTH_COOKIE_DOMAIN=example.com

# Resend Email
RESEND_API_KEY=re_placeholder

# Cloudflare resource IDs: injected into dist/ by `vite build`, never written to wrangler.jsonc
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# KV_NAMESPACE_ID=
# R2_BUCKET_NAME=prod-storage

# Branding and cross-app links (public; bundled into the client)
# VITE_APP_NAME=Template
# VITE_STOREFRONT_URL=https://example.com
# VITE_DASHBOARD_URL=https://admin.example.com
