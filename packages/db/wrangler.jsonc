{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "db-migrations",
  "compatibility_date": "2026-02-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prod-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./src/migrations",
    },
  ],
}
